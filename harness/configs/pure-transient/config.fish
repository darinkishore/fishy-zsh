# darin's fish prompt setup (pure + jj/git override), as home-manager writes it.
# conf.d/plugin-pure.fish is generated by fz.py (plugin path from ./deps).
set -g fish_greeting
# Only to keep the duration scenario short: darin's value is the default, 5.
set -g pure_threshold_command_duration 1
# fish 4.1+ transient prompt (pure renders --final-rendering)
set -g fish_transient_prompt 1
