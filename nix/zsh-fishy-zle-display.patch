+/*
+ * zle_display: display-only edits of the edit buffer.
+ *
+ * Each element is "START END TEXT": TEXT is drawn in place of the buffer
+ * characters [START,END), or inserted before buffer offset START when
+ * START == END.  The buffer, $CURSOR and region_highlight offsets are not
+ * affected.  Inserted characters are drawn with the base attributes;
+ * replacement characters with those of the buffer character they replace.
+ * The cursor at START of an insertion is drawn after the inserted text.
+ * Elements overlapping an earlier one are ignored; edits reaching beyond
+ * the end of the buffer are not applied.  The array is cleared whenever a
+ * new line is read, like PREDISPLAY and POSTDISPLAY.
+ */
+struct zle_display_edit {
+    int start, end;		/* buffer offsets, half open */
+    ZLE_STRING_T text;		/* text to draw */
+    int len, sz;		/* its length and allocated size */
+    char *spec;			/* the original element, for reading back */
+};
+static struct zle_display_edit *zle_display_edits;
+static int n_zle_display_edits, alloc_zle_display_edits;
+
+static void
+free_zle_display_edit(struct zle_display_edit *d)
+{
+    if (d->text)
+	zfree(d->text, d->sz * sizeof(ZLE_CHAR_T));
+    zsfree(d->spec);
+    d->text = NULL;
+    d->spec = NULL;
+}
+
+/**/
+void
+free_zle_display(void)
+{
+    int i;
+    for (i = 0; i < n_zle_display_edits; i++)
+	free_zle_display_edit(zle_display_edits + i);
+    if (zle_display_edits)
+	zfree(zle_display_edits,
+	      alloc_zle_display_edits * sizeof(struct zle_display_edit));
+    zle_display_edits = NULL;
+    n_zle_display_edits = alloc_zle_display_edits = 0;
+}
+
+/**/
+char **
+get_zle_display(UNUSED(Param pm))
+{
+    char **retarr = (char **)zhalloc((n_zle_display_edits + 1) * sizeof(char *));
+    int i;
+    for (i = 0; i < n_zle_display_edits; i++)
+	retarr[i] = dupstring(zle_display_edits[i].spec);
+    retarr[i] = NULL;
+    return retarr;
+}
+
+static int
+zle_display_cmp(const void *a, const void *b)
+{
+    const struct zle_display_edit *x = a, *y = b;
+    if (x->start != y->start)
+	return x->start < y->start ? -1 : 1;
+    /* An insertion at START comes before a replacement starting there. */
+    return (x->end - x->start) - (y->end - y->start);
+}
+
+/**/
+void
+set_zle_display(UNUSED(Param pm), char **aval)
+{
+    int n, i, kept;
+    char **av;
+
+    free_zle_display();
+    if (!aval)
+	return;
+    n = arrlen(aval);
+    if (!n) {
+	freearray(aval);
+	return;
+    }
+    zle_display_edits = (struct zle_display_edit *)
+	zshcalloc(n * sizeof(struct zle_display_edit));
+    alloc_zle_display_edits = n;
+    for (av = aval; *av; av++) {
+	char *str = *av, *endp;
+	struct zle_display_edit *d;
+	zlong start, end;
+
+	start = zstrtol(str, &endp, 10);
+	if (endp == str || *endp != ' ')
+	    continue;
+	str = endp + 1;
+	end = zstrtol(str, &endp, 10);
+	if (endp == str || (*endp && *endp != ' '))
+	    continue;
+	if (*endp == ' ')
+	    endp++;
+	if (start < 0 || end < start)
+	    continue;
+	d = zle_display_edits + n_zle_display_edits++;
+	d->start = (int)start;
+	d->end = (int)end;
+	d->text = stringaszleline(endp, 0, &d->len, &d->sz, NULL);
+	d->spec = ztrdup(*av);
+    }
+    freearray(aval);
+    if (n_zle_display_edits < 2)
+	return;
+    qsort(zle_display_edits, n_zle_display_edits,
+	  sizeof(struct zle_display_edit), zle_display_cmp);
+    /* Drop edits that overlap an earlier one. */
+    for (i = 1, kept = 1; i < n_zle_display_edits; i++) {
+	struct zle_display_edit *prev = zle_display_edits + kept - 1;
+	struct zle_display_edit *cur = zle_display_edits + i;
+	int prev_insert = prev->start == prev->end;
+	int cur_insert = cur->start == cur->end;
+	int ok;
+	if (cur->start == prev->start)
+	    /* only "insertion, then replacement" may share a START */
+	    ok = prev_insert && !cur_insert;
+	else
+	    ok = cur->start >= prev->end;
+	if (!ok) {
+	    free_zle_display_edit(cur);
+	    continue;
+	}
+	if (kept != i) {
+	    zle_display_edits[kept] = *cur;
+	    cur->text = NULL;
+	    cur->spec = NULL;
+	}
+	kept++;
+    }
+    n_zle_display_edits = kept;
+}
+
+/**/
+void
+unset_zle_display(Param pm, int exp)
+{
+    if (exp) {
+	set_zle_display(pm, NULL);
+	stdunsetfn(pm, exp);
+    }
+}
+
+/*
+ * Apply zle_display edits to LINE (PREDISPLAY + buffer + POSTDISPLAY, LL
+ * characters, cursor at CS).  Returns a newly allocated line, or NULL if no
+ * edit applies.  *OUTLOG maps each output character to its position in LINE
+ * (-1 for inserted characters), which is used for highlighting.
+ */
+static ZLE_STRING_T
+apply_zle_display(ZLE_STRING_T line, int ll, int cs,
+		  int *outll, int *outcs, int **outlog)
+{
+    ZLE_STRING_T out;
+    int *log, total = ll, used = 0, i, o, p, e, newcs = -1;
+
+    for (i = 0; i < n_zle_display_edits; i++) {
+	struct zle_display_edit *d = zle_display_edits + i;
+	if (d->end > zlell)
+	    break;		/* sorted by START, and END >= START */
+	total += d->len - (d->end - d->start);
+	used++;
+    }
+    if (!used)
+	return NULL;
+    out = (ZLE_STRING_T)zalloc((total ? total : 1) * sizeof(*out));
+    log = (int *)zalloc((total ? total : 1) * sizeof(int));
+    for (o = 0, p = 0, e = 0; p <= ll; ) {
+	int replaced = 0;
+	while (e < used && p == predisplaylen + zle_display_edits[e].start) {
+	    struct zle_display_edit *d = zle_display_edits + e++;
+	    int rlen = d->end - d->start, k;
+	    for (k = 0; k < d->len; k++) {
+		if (rlen && newcs < 0 && cs == p + k)
+		    newcs = o;
+		out[o] = d->text[k];
+		log[o] = rlen ? p + (k < rlen ? k : rlen - 1) : -1;
+		o++;
+	    }
+	    if (rlen) {
+		if (newcs < 0 && cs >= p && cs < p + rlen)
+		    newcs = o;	/* cursor beyond shorter replacement text */
+		p += rlen;
+		replaced = 1;
+		break;
+	    }
+	}
+	if (replaced)
+	    continue;
+	if (newcs < 0 && cs == p)
+	    newcs = o;
+	if (p == ll)
+	    break;
+	out[o] = line[p];
+	log[o] = p;
+	o++;
+	p++;
+    }
+    DPUTS(o != total, "BUG: zle_display length mismatch");
+    *outll = o;
+    *outcs = newcs < 0 ? o : newcs;
+    *outlog = log;
+    return out;
+}
