+}
+
+fn hsearch_report(streams: &mut IoStreams, found: bool) {
+    HSEARCH.with_borrow(|hs| {
+        if !hs.active() {
+            record(streams, &[L!("H"), L!("0"), L!("1"), L!(""), L!("0"), L!("0"), L!("-1"), L!("0")]);
+            return;
+        }
+        let res = hs.search_result_range();
+        let (mstart, mlen) = match hs.search_range_if_active() {
+            Some(r) => (num(r.start()), num(r.length())),
+            None => (L!("-1").to_owned(), L!("0").to_owned()),
+        };
+        record(
+            streams,
+            &[
+                L!("H"),
+                if found { L!("1") } else { L!("0") },
+                if hs.is_at_present() { L!("1") } else { L!("0") },
+                hs.current_result(),
+                &num(res.start),
+                &num(res.end),
+                &mstart,
+                &mlen,
+            ],
+        );
+    });
+}
