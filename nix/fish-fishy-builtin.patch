+//! fishy-zsh: the screen's prompt handling, for the `__fishy prompt` builtin.
+//!
+//! zsh draws the prompt, so it needs fish's *result*: the prompt truncated
+//! exactly like `compute_layout` truncates it, the OSC 133 marks where
+//! `Screen::update` writes them, and every width as fish measures it. The
+//! prompt is returned in zsh prompt syntax so zsh's own width accounting
+//! cannot disagree with fish's: escape sequences become `%{...%}` and visible
+//! text becomes `%{text%NG%}` with N = fish's width for that text.
+
+use super::*;
+use crate::terminal::TerminalCommand;
+
+/// fish's PROMPT_SP sequence (`None`: the first prompt, just `\r`).
+pub(crate) fn abandon_line(screen_width: Option<usize>) -> Vec<u8> {
+    abandon_line_string(screen_width)
+}
+
+pub(crate) struct ZshPrompt {
+    /// The prompt in zsh prompt syntax (needs PROMPT_PERCENT; see `pct`).
+    pub(crate) text: WString,
+    /// Width of the last line, as `compute_layout` measures it.
+    pub(crate) last_line_width: usize,
+    /// Number of lines.
+    pub(crate) lines: usize,
+}
+
+/// zsh prompt-escape one piece of literal text: `%` is the only character
+/// zsh interprets once PROMPT_SUBST and PROMPT_BANG are off (bridge sets PS1
+/// through a parameter when they are on, so this stays sufficient).
+fn pct(out: &mut WString, s: &wstr) {
+    for c in s.chars() {
+        if c == '%' {
+            out.push('%');
+        }
+        out.push(c);
+    }
+}
+
+fn mark(cmd: TerminalCommand<'_>) -> WString {
+    let mut o = Outputter::new_buffering_no_assume_normal();
+    o.write_command(cmd);
+    fish_widestring::bytes2wcstring(&o.take_contents())
+}
+
+/// One prompt line (no line terminator) in zsh syntax.
+fn convert_line(out: &mut WString, line: &wstr, cache: &mut LayoutCache) -> usize {
+    // fish's width is that of the last run: '\r' is a run terminator that
+    // restarts the measurement (measure_run_from). Everything up to and
+    // including the last '\r' is therefore zero-width for zsh too.
+    let run_start = line
+        .as_char_slice()
+        .iter()
+        .rposition(|&c| c == '\r')
+        .map_or(0, |i| i + 1);
+    if run_start > 0 {
+        out.push_str("%{");
+        pct(out, &line[..run_start]);
+        out.push_str("%}");
+    }
+
+    let line = &line[run_start..];
+    let mut fish_width = 0usize; // measure_run_from's running width
+    let mut told_zsh = 0usize; // width already asserted to zsh with %G
+    let mut text = WString::new();
+    let flush = |out: &mut WString, text: &mut WString, fish_width: usize, told: &mut usize| {
+        if text.is_empty() {
+            return;
+        }
+        out.push_str("%{");
+        pct(out, text);
+        let glitch = fish_width.saturating_sub(*told);
+        if glitch > 0 {
+            out.push_str(&format!("%{glitch}G"));
+            *told += glitch;
+        }
+        out.push_str("%}");
+        text.clear();
+    };
+
+    let mut idx = 0;
+    while idx < line.len() {
+        let c = line.char_at(idx);
+        if c == '\x1B' {
+            let len = cache.escape_code_length(&line[idx..]);
+            if len > 0 {
+                flush(out, &mut text, fish_width, &mut told_zsh);
+                out.push_str("%{");
+                pct(out, &line[idx..idx + len]);
+                out.push_str("%}");
+                idx += len;
+            } else {
+                // Unrecognized: measure_run_from skips a lone ESC as width 0.
+                text.push(c);
+                idx += 1;
+            }
+            continue;
+        }
+        if c == '\t' {
+            fish_width = next_tab_stop(fish_width);
+        } else if let Ok(w) = usize::try_from(fish_wcwidth_visible(c)) {
+            fish_width += w;
+        } else {
+            fish_width = fish_width.saturating_sub(1);
+        }
+        text.push(c);
+        idx += 1;
+    }
+    flush(out, &mut text, fish_width, &mut told_zsh);
+    fish_width
+}
+
+/// `prompt` laid out for a `screen_width`-wide screen exactly like
+/// `compute_layout` + `Screen::update` do: truncated per line with an
+/// ellipsis, `ESC[K` before every line but the last, OSC 133 A before the
+/// first line and B after the last (when `marks`).
+pub(crate) fn zsh_prompt(prompt: &wstr, screen_width: usize, marks: bool) -> ZshPrompt {
+    let mut cache = LAYOUT_CACHE_SHARED.lock().unwrap();
+    let mut trunc = WString::new();
+    let layout = cache.calc_prompt_layout(prompt, Some(&mut trunc), screen_width);
+    let nlines = layout.line_starts.len();
+
+    let mut text = WString::new();
+    let mut last_line_width = 0;
+    for (i, &start) in layout.line_starts.iter().enumerate() {
+        let is_last = i + 1 == nlines;
+        // Line i ends at the terminator ('\n' or '\x0C') before the next start.
+        let end = if is_last {
+            trunc.len()
+        } else {
+            layout.line_starts[i + 1] - 1
+        };
+        if !is_last {
+            text.push_str("%{");
+            pct(&mut text, &mark(TerminalCommand::ClearToEndOfLine));
+            text.push_str("%}");
+        }
+        if marks && i == 0 {
+            text.push_str("%{");
+            pct(&mut text, &mark(TerminalCommand::Osc133PromptStart));
+            text.push_str("%}");
+        }
+        last_line_width = convert_line(&mut text, &trunc[start..end], &mut cache);
+        if !is_last {
+            // fish writes the terminator as is; for zsh a line break is '\n'
+            // (a form feed would leave zsh's idea of the column wrong).
+            text.push('\n');
+        }
+    }
+    if marks {
+        text.push_str("%{");
+        pct(&mut text, &mark(TerminalCommand::Osc133PromptEnd));
+        text.push_str("%}");
+    }
+    debug_assert_eq!(last_line_width, layout.last_line_width);
+    ZshPrompt {
+        text,
+        last_line_width: layout.last_line_width,
+        lines: nlines,
+    }
+}
