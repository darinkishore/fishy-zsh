+// ---------------------------------------------------------------------------
+// Prompt, title and command-lifecycle output.
+//
+// In fish these bytes go straight to the terminal: event handlers, the title
+// and OSC 133 marks write to fds 1/2 directly (not through IoStreams, so no
+// redirection or pipe catches them). The server's replies travel on fd 3, so
+// fds 1/2 can be pointed at a scratch file for the duration and the bytes
+// handed to zsh in the order fish would have written them.
+
+thread_local! {
+    static CAPTURE: RefCell<Option<std::fs::File>> = const { RefCell::new(None) };
+}
+
+/// Run `f` with fds 1 and 2 writing into a scratch file; returns its contents.
+fn capture_fds<R>(f: impl FnOnce() -> R) -> (R, Vec<u8>) {
+    use std::io::{Read, Seek, SeekFrom};
+    use std::os::fd::AsRawFd;
+    CAPTURE.with(|cap| {
+        let mut cap = cap.borrow_mut();
+        if cap.is_none() {
+            // Unlinked right away: nothing is left behind if the server dies.
+            let tmp = fish_tempfile::new_file().expect("fishy: scratch file");
+            *cap = Some(tmp.get().try_clone().expect("fishy: scratch file"));
+        }
+        let file = cap.as_mut().unwrap();
+        let _ = file.set_len(0);
+        let _ = file.seek(SeekFrom::Start(0));
+        let fd = file.as_raw_fd();
+        // SAFETY: plain fd juggling on fds we own; restored before returning.
+        let (saved1, saved2) = unsafe { (libc::dup(1), libc::dup(2)) };
+        unsafe {
+            libc::dup2(fd, 1);
+            libc::dup2(fd, 2);
+        }
+        let r = f();
+        unsafe {
+            libc::dup2(saved1, 1);
+            libc::dup2(saved2, 2);
+            libc::close(saved1);
+            libc::close(saved2);
+        }
+        let mut bytes = vec![];
+        let _ = file.seek(SeekFrom::Start(0));
+        let _ = file.read_to_end(&mut bytes);
+        (r, bytes)
+    })
+}
+
+/// Raw terminal bytes as one record field (NULs would end the record; a
+/// terminal ignores them anyway).
+fn bytes_field(bytes: &[u8]) -> WString {
+    let clean: Vec<u8> = bytes.iter().copied().filter(|&b| b != 0).collect();
+    bytes2wcstring(&clean)
+}
+
+/// The program fish's `status current-command` reports at the prompt
+/// (`get_program_name()` in fish). This is zsh: titles say so.
+const PROGRAM: &wstr = L!("zsh");
+
+fn parse_int(s: &wstr) -> Option<i32> {
+    s.to_string().parse().ok()
+}
+
+/// COLUMNS LINES: what reader_update_termsize would read from the tty.
+fn set_termsize(parser: &mut Parser, cols: &wstr, lines: &wstr) {
+    let mode = ParserEnvSetMode::new(EnvMode::GLOBAL);
+    for (name, val) in [(L!("COLUMNS"), cols), (L!("LINES"), lines)] {
+        if parser.vars().get(name).is_none_or(|v| v.as_string() != val) {
+            parser.set_var_and_fire(name, mode, vec![val.to_owned()]);
+        }
+    }
+    termsize_update(parser);
+}
+
+/// STATUS PIPESTATUS...: zsh's $? and $pipestatus become fish's.
+fn set_statuses(parser: &Parser, status: &wstr, pipestatus: &[WString]) -> Option<()> {
+    let status = parse_int(status)?;
+    let mut pipe = vec![];
+    for p in pipestatus {
+        pipe.push(parse_int(p)?);
+    }
+    if pipe.is_empty() {
+        pipe.push(status);
+    }
+    parser.set_last_statuses(Statuses {
+        status,
+        kill_signal: None,
+        pipestatus: pipe,
+    });
+    Some(())
+}
+
+/// At the prompt fish resets `status current-command`/`commandline` and `$_`.
+fn reset_status_vars(parser: &mut Parser) {
+    parser.libdata_mut().status_vars.command = PROGRAM.to_owned();
+    parser.libdata_mut().status_vars.commandline = WString::new();
+    parser.set_one(
+        L!("_"),
+        ParserEnvSetMode::new(EnvMode::GLOBAL),
+        PROGRAM.to_owned(),
+    );
+}
+
+/// Reader::exec_prompt without a Reader: the mode, left and right prompts
+/// (stdout captured by exec_subshell like fish does), then the title.
+fn run_prompt(parser: &mut Parser, final_prompt: bool) -> (WString, WString) {
+    let _suppress_trace = parser.push_scope(|s| s.suppress_fish_trace = true);
+    let _noninteractive = parser.push_scope(|s| s.is_interactive = false);
+
+    let mut mode = WString::new();
+    if function::exists(MODE_PROMPT_FUNCTION_NAME, parser) {
+        mode = WString::from_iter(exec_prompt_cmd(parser, MODE_PROMPT_FUNCTION_NAME, final_prompt));
+    }
+
+    let left_cmd = if function::exists(LEFT_PROMPT_FUNCTION_NAME, parser) {
+        LEFT_PROMPT_FUNCTION_NAME
+    } else {
+        DEFAULT_PROMPT
+    };
+    let mut left = join_strings(&exec_prompt_cmd(parser, left_cmd, final_prompt), '\n');
+    if let Some(prefix) = parser.vars().get_unless_empty(L!("SHELL_PROMPT_PREFIX")) {
+        left.insert_utfstr(0, &prefix.as_string());
+    }
+    if let Some(suffix) = parser.vars().get_unless_empty(L!("SHELL_PROMPT_SUFFIX")) {
+        left.push_utfstr(&suffix.as_string());
+    }
+
+    let mut right = WString::new();
+    if function::exists(RIGHT_PROMPT_FUNCTION_NAME, parser) {
+        right = WString::from_iter(exec_prompt_cmd(parser, RIGHT_PROMPT_FUNCTION_NAME, final_prompt));
+    }
+
+    reader_write_title(L!(""), parser, false);
+    job_reap(parser, true, None);
+    // The screen draws the mode prompt in front of the left prompt.
+    (mode + &left[..], right)
+}
+
+/// Names in the directories of list variable `var` (with `suffix` stripped,
+/// entries without it skipped). A superset check before fish's exact lookups.
+fn dir_entries(
+    parser: &Parser,
+    var: &wstr,
+    suffix: Option<&str>,
+) -> std::collections::HashSet<WString> {
+    let mut names = std::collections::HashSet::new();
+    let Some(dirs) = parser.vars().get(var) else {
+        return names;
+    };
+    for dir in dirs.as_list() {
+        let Ok(rd) = std::fs::read_dir(fish_widestring::wcs2osstring(dir)) else {
+            continue;
+        };
+        for entry in rd.flatten() {
+            let raw = std::os::unix::ffi::OsStrExt::as_bytes(entry.file_name().as_os_str()).to_vec();
+            let raw = match suffix {
+                Some(sfx) => match raw.strip_suffix(sfx.as_bytes()) {
+                    Some(stem) => stem.to_vec(),
+                    None => continue,
+                },
+                None => raw,
+            };
+            names.insert(bytes2wcstring(&raw));
+        }
+    }
+    names
+}
+
+pub fn fishy(parser: &mut Parser, streams: &mut IoStreams, argv: &mut [&wstr]) -> BuiltinResult {
+    let args: Vec<WString> = argv.iter().map(|a| (*a).to_owned()).collect();
+    // `__fishy reply ID [SUBCOMMAND ARGS...]`: run the subcommand, then write
+    // its records and the terminator \x1e ID to the reply fd in one go.
+    if args.get(1).is_some_and(|a| a == "reply") {
+        let Some(id) = args.get(2) else {
+            return Err(STATUS_INVALID_ARGS);
+        };
+        REPLY_SINK.with(|sink| *sink.borrow_mut() = Some(vec![]));
+        let res = if args.len() > 3 {
+            let rest: Vec<WString> = std::iter::once(args[0].clone())
+                .chain(args[3..].iter().cloned())
+                .collect();
+            dispatch(parser, streams, &rest)
+        } else {
+            Ok(SUCCESS)
+        };
+        let mut bytes = REPLY_SINK.with(|sink| sink.borrow_mut().take()).unwrap_or_default();
+        bytes.push(0x1e);
+        bytes.extend_from_slice(&wcs2bytes(id));
+        bytes.push(0);
+        let _ = write_loop(&REPLY_FD, &bytes);
+        return res;
+    }
+    dispatch(parser, streams, &args)
+}
+
+fn dispatch(parser: &mut Parser, streams: &mut IoStreams, args: &[WString]) -> BuiltinResult {
+    let arg = |i: usize| args.get(i).map(|s| s.as_utfstr());
+    let bad = Err(STATUS_INVALID_ARGS);
+    match arg(1).map(|s| s.to_string()).as_deref() {
+        Some("complete") => {
+            let (Some(cur), Some(line)) = (arg(2).and_then(parse_usize), arg(3)) else {
+                return bad;
+            };
+            do_complete(parser, streams, cur, line);
+        }
+        Some("suggest") => {
+            let (Some(cur), Some(line)) = (arg(2).and_then(parse_usize), arg(3)) else {
+                return bad;
+            };
+            do_suggest(parser, streams, cur, line);
+        }
+        Some("history-add") => {
+            let (Some(_cwd), Some(text)) = (arg(2), arg(3)) else {
+                return bad;
+            };
+            do_history_add(parser, text, arg(4).is_some_and(|m| m == "memory"));
+        }
+        Some("history-resolve") => {
+            // [nosave]: the async server's in-memory copy.
+            let hist = history(parser);
+            hist.resolve_pending();
+            if arg(2).is_none_or(|m| m != "nosave") {
+                hist.save();
+            }
+        }
+        Some("hsearch-reset") => {
+            let (Some(mode), Some(off), Some(text)) =
+                (arg(2).and_then(parse_mode), arg(3).and_then(parse_usize), arg(4))
+            else {
+                return bad;
+            };
+            let hist = history(parser);
+            HSEARCH.with_borrow_mut(|hs| {
+                hs.reset_to_mode(text.to_owned(), hist, mode, off);
+                if let Some(skip) = arg(5) {
+                    if !skip.is_empty() {
+                        hs.add_skip(skip.to_owned());
+                    }
+                }
+            });
+            hsearch_report(streams, true);
+        }
+        Some("hsearch-move") => {
+            let found = HSEARCH.with_borrow_mut(|hs| {
+                if !hs.active() {
+                    return false;
+                }
+                match arg(2).map(|s| s.to_string()).as_deref() {
+                    Some("b") => hs.move_in_direction(SearchDirection::Backward),
+                    Some("f") => hs.move_in_direction(SearchDirection::Forward),
+                    Some("oldest") => {
+                        hs.go_to_oldest();
+                        true
+                    }
+                    Some("present") => {
+                        hs.go_to_present();
+                        true
+                    }
+                    _ => false,
+                }
+            });
+            hsearch_report(streams, found);
+        }
+        Some("hsearch-delete") => {
+            // history-delete during a history search (reader.rs HistoryDelete):
+            // remove the current result from the history, save, and move on
+            // (handle_deletion). Replies like hsearch-move.
+            let hist = history(parser);
+            let found = HSEARCH.with_borrow_mut(|hs| {
+                if !hs.active() || hs.is_at_present() {
+                    return false;
+                }
+                hist.remove(hs.current_result());
+                hist.save();
+                hs.handle_deletion();
+                true
+            });
+            hsearch_report(streams, found);
+        }
+        Some("history-remove") => {
+            // history-delete on an autosuggestion: remove that history item, save.
+            // [forget]: the async server's copy, which never writes the file:
+            // the sync server removed and saved; drop the item from memory and
+            // re-read the file (a save here would rewrite the file, dropping
+            // on-disk items that duplicate its in-memory-only ones).
+            let Some(text) = arg(2) else {
+                return bad;
+            };
+            let hist = history(parser);
+            if arg(3).is_some_and(|m| m == "forget") {
+                hist.fishy_forget(text);
+            } else {
+                hist.remove(text);
+                hist.save();
+            }
+        }
+        Some("hsearch-end") => {
+            HSEARCH.with_borrow_mut(|hs| hs.reset());
+        }
+        Some("word") => {
+            let (Some(dir), Some(style), Some(to_end), Some(pos), Some(text)) = (
+                arg(2),
+                arg(3).and_then(parse_style),
+                arg(4),
+                arg(5).and_then(parse_usize),
+                arg(6),
+            ) else {
+                return bad;
+            };
+            let dir = if dir == "l" { MoveWordDir::Left } else { MoveWordDir::Right };
+            let p = word_motion(text, pos.min(text.len()), dir, style, to_end == "1");
+            record(streams, &[L!("P"), &num(p)]);
+        }
+        Some("accept-word") => {
+            // Mirrors AutosuggestionPortion::PerMoveWordStyle in accept_autosuggestion.
+            let (Some(style), Some(to_end), Some(have), Some(text)) = (
+                arg(2).and_then(parse_style),
+                arg(3),
+                arg(4).and_then(parse_usize),
+                arg(5),
+            ) else {
+                return bad;
+            };
+            let dir = if to_end == "1" { MoveWordDir::Left } else { MoveWordDir::Right };
+            let mut state = MoveWordStateMachine::new(style, dir);
+            let mut want = have.min(text.len());
+            while want < text.len() {
+                if state.consume_char(text, want) {
+                    want += 1;
+                } else {
+                    break;
+                }
+            }
+            record(streams, &[L!("P"), &num(want)]);
+        }
+        Some("apply") => {
+            let (Some(z), Some(val), Some(flags), Some(cur), Some(ao), Some(uq), Some(line)) = (
+                arg(2).map(ZshOpts::parse),
+                arg(3),
+                arg(4).and_then(parse_flags),
+                arg(5).and_then(parse_usize),
+                arg(6),
+                arg(7),
+                arg(8),
+            ) else {
+                return bad;
+            };
+            let mut cursor = cur.min(line.len());
+            let new_line = zsh_apply(
+                &mut OperationContext::background_interruptible(parser.vars()),
+                val,
+                flags,
+                line,
+                &mut cursor,
+                ao == "1",
+                uq == "1",
+                z,
+            );
+            record(streams, &[L!("A"), &new_line, &num(cursor)]);
+        }
+        Some("pager-filter") => {
+            // Mirrors Pager::completion_info_passes_filter (with a non-empty needle).
+            let (Some(needle), Some(prefix)) = (arg(2), arg(3)) else {
+                return bad;
+            };
+            let rest = &args[4..];
+            if rest.len() % 2 != 0 {
+                return bad;
+            }
+            for (i, pair) in rest.chunks(2).enumerate() {
+                let passes = string_fuzzy_match_string(needle, &pair[0], false).is_some()
+                    || pair[1].as_char_slice().split(|&c| c == '\x1e').any(|comp| {
+                        let mut full = prefix.to_owned();
+                        full.push_utfstr(wstr::from_char_slice(comp));
+                        string_fuzzy_match_string(needle, &full, false).is_some()
+                    });
+                if passes {
+                    record(streams, &[L!("M"), &num(i)]);
+                }
+            }
+        }
+        Some("token-extent") => {
+            let (Some(cur), Some(line)) = (arg(2).and_then(parse_usize), arg(3)) else {
+                return bad;
+            };
+            let (tok, prev) = get_token_extent(line, cur.min(line.len()));
+            record(
+                streams,
+                &[L!("E"), &num(tok.start), &num(tok.end), &num(prev.start), &num(prev.end)],
+            );
+        }
+        Some("backward-token") => {
+            let (Some(pos), Some(line)) = (arg(2).and_then(parse_usize), arg(3)) else {
+                return bad;
+            };
+            let pos = pos.min(line.len());
+            if pos == 0 {
+                record(streams, &[L!("N")]);
+            } else {
+                let (tok, prev_tok) = get_token_extent(line, pos);
+                let new_position = if tok.start == pos {
+                    if prev_tok.start == pos {
+                        let cmdsub = get_cmdsubst_extent(line, prev_tok.start);
+                        cmdsub.start.saturating_sub(1)
+                    } else {
+                        prev_tok.start
+                    }
+                } else {
+                    tok.start
+                };
+                record(streams, &[L!("P"), &num(new_position)]);
+            }
+        }
+        Some("forward-token") => {
+            let (Some(pos), Some(line)) = (arg(2).and_then(parse_usize), arg(3)) else {
+                return bad;
+            };
+            let pos = pos.min(line.len());
+            if pos == line.len() {
+                record(streams, &[L!("N")]);
+            } else {
+                let cmdsubst_range = get_cmdsubst_extent(line, pos);
+                let mut result = line.len();
+                for token in Tokenizer::new(
+                    &line[cmdsubst_range.clone()],
+                    TokFlags { accept_unfinished: true, ..Default::default() },
+                ) {
+                    if token.type_ != TokenType::String {
+                        continue;
+                    }
+                    let tok_end = cmdsubst_range.start + token.end();
+                    if tok_end > pos {
+                        result = tok_end;
+                        break;
+                    }
+                }
+                record(streams, &[L!("P"), &num(result)]);
+            }
+        }
+        Some("expand-abbr") => {
+            let (Some(cur), Some(line)) = (arg(2).and_then(parse_usize), arg(3)) else {
+                return bad;
+            };
+            if let Some(r) = reader_expand_abbreviation_at_cursor(line, cur.min(line.len()), parser) {
+                let start = r.range.start();
+                let end = start + r.range.length();
+                let cursor = match r.cursor {
+                    Some(c) => num(c),
+                    None => L!("-1").to_owned(),
+                };
+                record(streams, &[L!("R"), &num(start), &num(end), &r.text, &cursor]);
+            }
+        }
+        Some("highlight") => {
+            let (Some(io), Some(cur), Some(line)) = (arg(2), arg(3).and_then(parse_usize), arg(4))
+            else {
+                return bad;
+            };
+            // Mirrors get_highlight_performer: vars snapshot + background context,
+            // run off the main thread (the file tester requires it).
+            let vars = parser.vars().snapshot();
+            let generation_count = read_generation_count();
+            let text = line.to_owned();
+            let io_ok = io == "1";
+            let position = cur.min(line.len());
+            let colors = std::thread::spawn(move || {
+                let mut colors = vec![];
+                if !text.is_empty() {
+                    let ctx = &mut get_bg_context(&vars, generation_count);
+                    highlight_shell(&text, &mut colors, ctx, io_ok, Some(position));
+                }
+                colors
+            })
+            .join()
+            .expect("highlight thread panicked");
+            // Emit runs of identical resolved faces ("none" runs are omitted:
+            // zsh draws unhighlighted text in the terminal default).
+            let mut resolver = HighlightColorResolver::new();
+            let faces: Vec<WString> = colors
+                .iter()
+                .map(|spec| face_to_zsh(&resolver.resolve_spec(spec, parser.vars())))
+                .collect();
+            let mut start = 0;
+            while start < faces.len() {
+                let mut end = start + 1;
+                while end < faces.len() && faces[end] == faces[start] {
+                    end += 1;
+                }
+                if faces[start] != "none" {
+                    record(streams, &[L!("H"), &num(start), &num(end), &faces[start]]);
+                }
+                start = end;
+            }
+        }
+        Some("define-commands") => {
+            // A zsh with compinit has ~2000 functions. fish's own lookups are
+            // exact but cost a stat per $PATH / function-path directory per
+            // name, so they only run for names some directory actually has.
+            let on_path = dir_entries(parser, L!("PATH"), None);
+            let fn_files = dir_entries(parser, L!("fish_function_path"), Some(".fish"));
+            let mut script = WString::new();
+            for name in &args[2..] {
+                // Never shadow anything fish already resolves (builtins such as
+                // `read` are used by the server loop itself), and leave real
+                // commands as commands.
+                if !crate::common::valid_func_name(name)
+                    || crate::builtins::builtin_exists(name)
+                    || ((function::exists_no_autoload(name) || fn_files.contains(name))
+                        && function::exists(name, parser))
+                    || (on_path.contains(name)
+                        && crate::path::path_get_path(name, parser.vars()).is_some())
+                {
+                    continue;
+                }
+                script.push_str("function ");
+                script.push_utfstr(&escape(name));
+                script.push_str("; end\n");
+            }
+            if !script.is_empty() {
+                let _ = parser.eval(&script, &crate::io::IoChain::new());
+            }
+        }
+        Some("complete-tokens") => {
+            // Mirrors the `complete -C` builtin: apply each completion to the
+            // current token as a fake command line, drop the trailing space.
+            let (Some(z), Some(line)) = (arg(2).map(ZshOpts::parse), arg(3)) else {
+                return bad;
+            };
+            let (token, _) = get_token_extent(line, line.len());
+            let options = CompletionRequestOptions::default();
+            let (mut comp, _) = complete(line, options, &mut parser.context());
+            sort_and_prioritize(&mut comp, options);
+            for next in comp {
+                let faux = &line[token.clone()];
+                let mut tmp_cursor = faux.len();
+                let mut with = zsh_apply(
+                    &mut OperationContext::background_interruptible(parser.vars()),
+                    &next.completion,
+                    next.flags,
+                    faux,
+                    &mut tmp_cursor,
+                    false,
+                    false,
+                    z,
+                );
+                if next.flags.suffix_type().is_some() && with.as_char_slice().last() == Some(&' ') {
+                    with.truncate(with.len() - 1);
+                }
+                record(streams, &[L!("K"), &with, &next.description]);
+            }
+        }
+        Some("bind-run") => {
+            // CURSOR LINE CODE: run a binding's fish code (e.g. a share/functions
+            // function) against zsh's command line, as eval_bind_cmd would.
+            //   O bytes          what it wrote (stdout and stderr)
+            //   B line cursor    the command line afterwards, if it changed
+            //   F name           each `commandline -f NAME`, in order (for zsh
+            //                    to run after applying B; fish runs them inline)
+            let (Some(cur), Some(line), Some(code)) =
+                (arg(2).and_then(parse_usize), arg(3), arg(4))
+            else {
+                return bad;
+            };
+            let cur = cur.min(line.len());
+            {
+                let mut st = commandline_state_snapshot();
+                *st = CommandlineState::new();
+                st.text = line.to_owned();
+                st.cursor_pos = cur;
+            }
+            let last_statuses = parser.vars().last_statuses();
+            // `commandline` works only once the reader would have initialized.
+            let was_initialized = parser.interactive_initialized;
+            parser.interactive_initialized = true;
+            crate::builtins::commandline::fishy_readline_capture_begin();
+            let ((), out) = capture_fds(|| {
+                let _ = parser.eval(code, &crate::io::IoChain::new());
+            });
+            let functions = crate::builtins::commandline::fishy_readline_capture_end();
+            parser.interactive_initialized = was_initialized;
+            parser.set_last_statuses(last_statuses);
+            let st = commandline_state_snapshot().clone();
+            record(streams, &[L!("O"), &bytes_field(&out)]);
+            if st.text != line || st.cursor_pos != cur {
+                record(streams, &[L!("B"), &st.text, &num(st.cursor_pos)]);
+            }
+            for f in &functions {
+                record(streams, &[L!("F"), f]);
+            }
+        }
+        Some("paste") => {
+            // __fish_paste SEARCH_SHOWN CURSOR LINE DATA (see zsh_paste)
+            //   S text          insert text into the pager's search field
+            //   B line cursor   the new command line (commandline --insert-smart)
+            //   (nothing)       nothing to insert
+            let (Some(search), Some(cur), Some(line), Some(data)) =
+                (arg(2), arg(3).and_then(parse_usize), arg(4), arg(5))
+            else {
+                return bad;
+            };
+            let root = parser
+                .eval(L!("fish_is_root_user"), &crate::io::IoChain::new())
+                .status
+                .is_success();
+            match zsh_paste(data, search == "1", line, cur.min(line.len()), root) {
+                PasteResult::SearchField(text) => record(streams, &[L!("S"), &text]),
+                PasteResult::Buffer(text, pos) => record(streams, &[L!("B"), &text, &num(pos)]),
+                PasteResult::Nothing => {}
+            }
+        }
+        Some("escape") => {
+            let Some(z) = arg(2).map(ZshOpts::parse) else {
+                return bad;
+            };
+            let flags = EscapeFlags {
+                no_quoted: true,
+                ..Default::default()
+            };
+            for item in &args[3..] {
+                record(streams, &[L!("Q"), &zsh_escape_script(item, flags, z)]);
+            }
+        }
+        Some("serve-init") => {
+            // No terminal was queried: XTVERSION is unknown (as for a terminal
+            // that does not answer), which OSC 133 marking needs initialized.
+            crate::tty_handoff::XTVERSION.get_or_init(WString::new);
+            // fish's greeting is fish saying hello; zsh is not fish.
+            let _ = parser.eval(L!("function fish_greeting; end"), &crate::io::IoChain::new());
+            // The server runs in zsh's process group while zle is reading, so the
+            // terminal's ^C / ^\ / ^Z would reach it; it must never react.
+            for sig in [libc::SIGINT, libc::SIGQUIT, libc::SIGTSTP, libc::SIGTTIN, libc::SIGTTOU] {
+                // SAFETY: setting a signal disposition to SIG_IGN is always sound.
+                unsafe {
+                    libc::signal(sig, libc::SIG_IGN);
+                }
+            }
+        }
+        Some("face") => {
+            // Groups of four: FG_ROLE BG_ROLE VALID_PATH FORCE_UNDERLINE.
+            let rest = &args[2..];
+            if rest.is_empty() || rest.len() % 4 != 0 {
+                return bad;
+            }
+            let mut resolver = HighlightColorResolver::new();
+            for group in rest.chunks(4) {
+                let (Some(fg), Some(bg)) = (parse_role(&group[0]), parse_role(&group[1])) else {
+                    return bad;
+                };
+                let spec = HighlightSpec {
+                    foreground: fg,
+                    background: bg,
+                    valid_path: group[2] == "1",
+                    force_underline: group[3] == "1",
+                };
+                let face = resolver.resolve_spec(&spec, parser.vars());
+                record(streams, &[L!("F"), &face_to_zsh(&face)]);
+            }
+        }
+        Some("postexec") => {
+            // read_i after reader_run_command: CMD_DURATION, the status
+            // generation, OSC 133 D, fish_postexec, then the cursor is shown.
+            let (Some(status), Some(ms), Some(cmd)) = (arg(2), arg(3), arg(4)) else {
+                return bad;
+            };
+            if !tok_command(cmd).is_empty() {
+                parser.set_one(
+                    ENV_CMD_DURATION,
+                    ParserEnvSetMode::new(EnvMode::UNEXPORT),
+                    ms.to_owned(),
+                );
+            }
+            STATUS_COUNT.fetch_add(1, Ordering::Relaxed);
+            if set_statuses(parser, status, &args[5..]).is_none() {
+                return bad;
+            }
+            reset_status_vars(parser);
+            let ((), out) = capture_fds(|| {
+                BufferedOutputter::new(Outputter::stdoutput()).write_command(
+                    Osc133CommandFinished {
+                        exit_status: parser.last_status(),
+                    },
+                );
+                event::fire_generic(parser, L!("fish_postexec").to_owned(), vec![cmd.to_owned()]);
+                Outputter::stdoutput()
+                    .borrow_mut()
+                    .write_command(DecsetShowCursor);
+            });
+            record(streams, &[L!("O"), &bytes_field(&out)]);
+        }
+        Some("prompt-event") => {
+            // readline's start: abandon the line (PROMPT_SP; just \r the first
+            // time), then the fish_prompt event. The first event also runs
+            // __fish_on_interactive, exactly like the first interactive prompt.
+            let (Some(first), Some(cols), Some(lines), Some(status)) =
+                (arg(2), arg(3), arg(4), arg(5))
+            else {
+                return bad;
+            };
+            set_termsize(parser, cols, lines);
+            if set_statuses(parser, status, &args[6..]).is_none() {
+                return bad;
+            }
+            let width = (first != "1").then(|| termsize_last().width());
+            let mut out = crate::screen::fishy::abandon_line(width);
+            let ((), ev) = capture_fds(|| {
+                event::fire_generic(parser, L!("fish_prompt").to_owned(), vec![]);
+            });
+            out.extend_from_slice(&ev);
+            record(streams, &[L!("O"), &bytes_field(&out)]);
+        }
+        Some("prompt") => {
+            // exec_prompt + the layout the screen would draw.
+            //   O bytes            (stderr of the prompt functions, the title)
+            //   L width lines ps1  (left prompt incl. mode prompt, zsh syntax)
+            //   R width rps1       (right prompt, zsh syntax)
+            //   X transient(0/1)   (fish_transient_prompt, as read_i reads it)
+            let (Some(final_prompt), Some(cols), Some(lines), Some(status)) =
+                (arg(2), arg(3), arg(4), arg(5))
+            else {
+                return bad;
+            };
+            set_termsize(parser, cols, lines);
+            if set_statuses(parser, status, &args[6..]).is_none() {
+                return bad;
+            }
+            reset_status_vars(parser);
+            let ((left, right), out) = capture_fds(|| run_prompt(parser, final_prompt == "1"));
+            let width = termsize_last().width();
+            let l = crate::screen::fishy::zsh_prompt(&left, width, true);
+            let r = crate::screen::fishy::zsh_prompt(&right, width, false);
+            record(streams, &[L!("O"), &bytes_field(&out)]);
+            record(streams, &[L!("L"), &num(l.last_line_width), &num(l.lines), &l.text]);
+            record(streams, &[L!("R"), &num(r.last_line_width), &r.text]);
+            let transient = check_bool_var(parser.vars(), L!("fish_transient_prompt"), false);
+            record(streams, &[L!("X"), if transient { L!("1") } else { L!("0") }]);
+        }
+        Some("exec") => {
+            // read_i + reader_run_command before eval: OSC 133 C, fish_preexec,
+            // `status current-command`, the title for the command.
+            let Some(cmd) = arg(2) else {
+                return bad;
+            };
+            let ((), out) = capture_fds(|| {
+                let mut o = BufferedOutputter::new(Outputter::stdoutput());
+                o.reset_text_face();
+                o.write_command(Osc133CommandStart(cmd));
+                drop(o);
+                event::fire_generic(parser, L!("fish_preexec").to_owned(), vec![cmd.to_owned()]);
+                let ft = tok_command(cmd);
+                if !ft.is_empty() {
+                    parser.libdata_mut().status_vars.command = ft.clone();
+                    parser.libdata_mut().status_vars.commandline = cmd.to_owned();
+                    parser.set_one(L!("_"), ParserEnvSetMode::new(EnvMode::GLOBAL), ft);
+                }
+                reader_write_title(cmd, parser, true);
+                Outputter::stdoutput()
+                    .borrow_mut()
+                    .set_text_face(TextFace::terminal_default());
+            });
+            record(streams, &[L!("O"), &bytes_field(&out)]);
+        }
+        Some("capture") => {
+            // Run FUNCTION ARGS... (if defined) and return what it wrote to the
+            // terminal: e.g. __fish_update_cwd_osc when zsh's $PWD changes.
+            let Some(func) = arg(2) else {
+                return bad;
+            };
+            if !function::exists(func, parser) {
+                record(streams, &[L!("O"), L!("")]);
+                return Ok(SUCCESS);
+            }
+            let mut cmd = escape(func);
+            for a in &args[3..] {
+                cmd.push(' ');
+                cmd.push_utfstr(&escape(a));
+            }
+            let ((), out) = capture_fds(|| {
+                let _ = parser.eval(&cmd, &crate::io::IoChain::new());
+            });
+            record(streams, &[L!("O"), &bytes_field(&out)]);
+        }
+        _ => return bad,
+    }
+    Ok(SUCCESS)
+}
+
+// ---------------------------------------------------------------------------
+// zsh-correct insertion of completions.
+//
+// `zsh_apply` is Reader's completion_apply_to_command_line with only the
+// quoting layer swapped: escaping and quote detection follow zsh's lexer
+// instead of fish's (zsh single quotes take no escapes; `?`, `!`, `` ` ``,
+// `^`/`#` (extendedglob) and a leading `=` are special; control characters
+// need $'...'). Everything else (token/suffix/slash/trailing-quote logic) is
+// fish's code unchanged.
+
+#[derive(Clone, Copy, Default)]
+struct ZshOpts {
+    extended_glob: bool,
+    bang_hist: bool,
+}
+
+impl ZshOpts {
+    fn parse(s: &wstr) -> Self {
+        let s = s.to_string();
+        ZshOpts {
+            extended_glob: s.contains('e'),
+            bang_hist: s.contains('h'),
+        }
+    }
+}
+
+/// $'...' spelling of a control character or raw byte (zsh cannot backslash-escape
+/// these outside of $'...').
+fn zsh_ansi_c(c: char) -> WString {
+    if let Some(byte) = decode_byte_from_char(c) {
+        return format!("$'\\x{byte:02X}'").into();
+    }
+    let inner: String = match c {
+        '\t' => "\\t".into(),
+        '\n' => "\\n".into(),
+        '\x08' => "\\b".into(),
+        '\r' => "\\r".into(),
+        '\x1B' => "\\e".into(),
+        '\x7F' => "\\x7f".into(),
+        c => format!("\\x{:02x}", u32::from(c)),
+    };
+    format!("$'{inner}'").into()
+}
+
+fn is_zsh_control(c: char) -> bool {
+    decode_byte_from_char(c).is_some() || matches!(c, '\x00'..='\x19' | '\x1B' | '\x7F')
+}
+
+/// fish's escape_string_script with zsh's special-character set.
+fn zsh_escape_script(input: &wstr, flags: EscapeFlags, z: ZshOpts) -> WString {
+    let escape_printables = !flags.no_printables;
+    let mut need_escape = false;
+    let mut need_complex_escape = flags.no_tilde && input.char_at(0) == '~';
+    let (mut double_quotes, mut single_quotes, mut dollars) = (0, 0, 0);
+    let mut has_bang = false;
+
+    if !flags.no_quoted && input.is_empty() {
+        return L!("''").to_owned();
+    }
+
+    let mut out = WString::with_capacity(input.len());
+    for (i, c) in input.chars().enumerate() {
+        if is_zsh_control(c) {
+            out.push_utfstr(&zsh_ansi_c(c));
+            need_escape = true;
+            need_complex_escape = true;
+            continue;
+        }
+        match c {
+            '\\' | '\'' => {
+                need_escape = true;
+                if c == '\'' {
+                    single_quotes += 1;
+                }
+                if escape_printables || c == '\\' {
+                    out.push('\\');
+                }
+                out.push(c);
+            }
+            fish_widestring::ANY_CHAR => out.push('?'),
+            fish_widestring::ANY_STRING => out.push('*'),
+            fish_widestring::ANY_STRING_RECURSIVE => out.push_str("**"),
+            ',' => {
+                if flags.comma {
+                    need_escape = true;
+                    out.push('\\');
+                }
+                out.push(c);
+            }
+            '&' | '$' | ' ' | '#' | '<' | '>' | '(' | ')' | '[' | ']' | '{' | '}' | '?' | '*'
+            | '|' | ';' | '"' | '%' | '~' | '`' | '!' | '^' | '=' => {
+                if c == '"' {
+                    double_quotes += 1;
+                }
+                if c == '$' {
+                    dollars += 1;
+                }
+                if c == '!' {
+                    has_bang = true;
+                }
+                let prev_alnum = i
+                    .checked_sub(1)
+                    .is_some_and(|p| input.char_at(p).is_alphanumeric());
+                let char_is_normal = match c {
+                    '~' => flags.no_tilde,
+                    '#' => prev_alnum && !z.extended_glob,
+                    '!' => !z.bang_hist,
+                    '^' => !z.extended_glob,
+                    '=' => i != 0, // EQUALS: only a leading '=' is special
+                    _ => false,
+                };
+                if !char_is_normal {
+                    need_escape = true;
+                    if escape_printables {
+                        out.push('\\');
+                    }
+                }
+                out.push(c);
+            }
+            _ => out.push(c),
+        }
+    }
+
+    if !flags.no_quoted && need_escape && !need_complex_escape && escape_printables {
+        // Same choice as fish, except that a history-expanding '!' cannot be
+        // escaped inside zsh double quotes, so single quotes win then.
+        let quote = if single_quotes > double_quotes + dollars && !(has_bang && z.bang_hist) {
+            '"'
+        } else {
+            '\''
+        };
+        out.clear();
+        out.push(quote);
+        out.push_utfstr(&zsh_escape_with_quote(input, Some(quote), EscapeFlags::default(), z));
+        out.push(quote);
+    }
+    out
+}
+
+/// fish's escape_string_with_quote for zsh quoting rules.
+fn zsh_escape_with_quote(cmd: &wstr, quote: Option<char>, flags: EscapeFlags, z: ZshOpts) -> WString {
+    let Some(quote) = quote else {
+        return zsh_escape_script(cmd, flags, z);
+    };
+    let mut result = WString::with_capacity(cmd.len());
+    for c in cmd.chars() {
+        if is_zsh_control(c) {
+            // Leave the quote, spell the character, re-enter the quote.
+            result.push(quote);
+            result.push_utfstr(&zsh_ansi_c(c));
+            result.push(quote);
+            continue;
+        }
+        match (quote, c) {
+            ('\'', '\'') => result.push_str("'\\''"),
+            ('"', '\\' | '"' | '$' | '`') => {
+                result.push('\\');
+                result.push(c);
+            }
+            ('"', '!') if z.bang_hist => {
+                // Cannot be escaped inside zsh double quotes: close, escape, reopen.
+                result.push_str("\"\\!\"");
+            }
+            _ => result.push(c),
+        }
+    }
+    result
+}
+
+/// zsh lexer state at each position: which quote (if any) is open *before* pos.
+fn zsh_quote_state(s: &wstr, upto: usize) -> Option<char> {
+    let cs = s.as_char_slice();
+    let mut q: Option<char> = None;
+    let mut i = 0;
+    while i < upto.min(cs.len()) {
+        let c = cs[i];
+        match q {
+            None => match c {
+                '\\' => i += 1,
+                '\'' | '"' => q = Some(c),
+                _ => {}
+            },
+            Some('\'') => {
+                if c == '\'' {
+                    q = None;
+                }
+            }
+            Some(_) => match c {
+                '\\' => i += 1,
+                '"' => q = None,
+                _ => {}
+            },
+        }
+        i += 1;
+    }
+    q
+}
+
+// ---------------------------------------------------------------------------
+// Bracketed paste: share/functions/__fish_paste.fish, line for line, with
+// zsh's quoting where fish's would write fish syntax.
+
+/// __fish_tokenizer_state's states. zsh's plain single quotes take no escapes
+/// (so fish's `single-escaped` cannot occur in them); zsh's `$'...'` takes
+/// backslash escapes exactly like fish's single quotes, so it gets fish's two
+/// single-quote states.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum PasteQuote {
+    Normal,
+    Single,
+    DollarSingle,
+    DollarSingleEscaped,
+    Double,
+    DoubleEscaped,
+    Escaped,
+}
+
+/// __fish_tokenizer_state -i INITIAL -- S, for zsh. Otherwise fish's state
+/// machine exactly, quirks included (a quote after a backslash leaves
+/// `escaped` as it is, as does `'` in `double-escaped`).
+fn zsh_tokenizer_state(s: &wstr, initial: PasteQuote) -> PasteQuote {
+    use PasteQuote::*;
+    let mut state = initial;
+    // Unquoted `$`s just seen: an odd run makes the next `'` start $'...'
+    // (`$$` is a parameter of its own).
+    let mut dollars = 0usize;
+    for c in s.chars() {
+        let before = state;
+        state = match (c, state) {
+            ('\'', Normal) if dollars % 2 == 1 => DollarSingle,
+            ('\'', Normal) => Single,
+            ('\'', DollarSingleEscaped) => DollarSingle,
+            ('\'', Single | DollarSingle) => Normal,
+            ('"', Normal | DoubleEscaped) => Double,
+            ('"', Double) => Normal,
+            ('\'' | '"', s) => s,
+            ('\\', Normal) => Escaped,
+            ('\\', Escaped) => Normal,
+            ('\\', Double) => DoubleEscaped,
+            ('\\', DoubleEscaped) => Double,
+            ('\\', DollarSingle) => DollarSingleEscaped,
+            ('\\', DollarSingleEscaped) => DollarSingle,
+            (_, Escaped) => Normal,
+            (_, DoubleEscaped) => Double,
+            (_, DollarSingleEscaped) => DollarSingle,
+            (_, s) => s,
+        };
+        dollars = if c == '$' && before == Normal && state == Normal { dollars + 1 } else { 0 };
+    }
+    state
+}
+
+/// `string trim -l` (default characters).
+fn trim_left(s: &wstr) -> WString {
+    let chars = s.as_char_slice();
+    let n = chars.iter().take_while(|c| " \x0C\n\r\t\x0B".contains(**c)).count();
+    s[n..].to_owned()
+}
+
+enum PasteResult {
+    SearchField(WString),
+    Buffer(WString, usize),
+    Nothing,
+}
+
+/// __fish_paste DATA, given the reader state it reads through `commandline`.
+fn zsh_paste(data: &wstr, search_field: bool, line: &wstr, cursor: usize, root: bool) -> PasteResult {
+    use PasteQuote::*;
+    // set -l data (string split \r -- $argv[1] | string split \n)
+    // set data (string replace -ra [[:cntrl:]] '' -- $data)
+    // ([[:cntrl:]] is ASCII-only in fish's PCRE2: U+0000-001F and U+007F.)
+    let mut data: Vec<WString> = data
+        .as_char_slice()
+        .split(|&c| c == '\r' || c == '\n')
+        .map(|l| l.iter().filter(|&&c| !(c < ' ' || c == '\x7F')).collect())
+        .collect();
+
+    // if commandline --search-field >/dev/null: commandline --search-field -i -- $data
+    if search_field {
+        return PasteResult::SearchField(join_strings(&data, '\n'));
+    }
+
+    // set -l quote_state (__fish_tokenizer_state -- (commandline -ct | string collect))
+    let (tok, _) = get_token_extent(line, cursor);
+    let token = &line[tok.start..cursor.max(tok.start)];
+    let kept = token.len() - token.chars().rev().take_while(|&c| c == '\n').count();
+    let token = &token[..kept]; // string collect drops trailing newlines
+    let mut quote_state = zsh_tokenizer_state(token, Normal);
+
+    match quote_state {
+        // An unmatched single quote: make the paste one literal token. fish
+        // backslashes ' and \; in zsh's plain single quotes that is '\''
+        // (backslashes are literal there), in $'...' it is fish's rule.
+        Single => {
+            for d in &mut data {
+                *d = d.replace(L!("'"), L!("'\\''"));
+            }
+        }
+        DollarSingle | DollarSingleEscaped => {
+            for d in &mut data {
+                let mut out = WString::new();
+                for c in d.chars() {
+                    if c == '\'' || c == '\\' {
+                        out.push('\\');
+                    }
+                    out.push(c);
+                }
+                *d = out;
+            }
+        }
+        Double | DoubleEscaped => {}
+        Normal | Escaped if data.len() > 1 => {
+            // Leading whitespace in subsequent lines is unneeded (fish indents).
+            let mut tmp = vec![];
+            for l in &data {
+                tmp.push(if quote_state == Normal { trim_left(l) } else { l.clone() });
+                quote_state = zsh_tokenizer_state(l, quote_state);
+            }
+            data.truncate(1);
+            data.extend(tmp.into_iter().skip(1));
+        }
+        Normal | Escaped => {}
+    }
+
+    // if not string length -q -- (commandline -c): at the very start, trim the
+    // first line so a leading space doesn't keep the command out of history.
+    // (The command substitution drops newlines: a prefix of only newlines
+    // counts as empty.)
+    if line[..cursor].chars().all(|c| c == '\n') {
+        data[0] = trim_left(&data[0]);
+    }
+
+    // if test -n "$data"
+    if data.len() == 1 && data[0].is_empty() {
+        return PasteResult::Nothing;
+    }
+    // commandline --insert-smart -- $data   (--insert for root)
+    let insert = join_strings(&data, '\n');
+    let insert = if root {
+        insert
+    } else {
+        crate::builtins::commandline::fishy_strip_dollar_prefixes(&line[..cursor], &insert)
+            .unwrap_or(insert)
+    };
+    let mut out = line[..cursor].to_owned();
+    out.push_utfstr(&insert);
+    out.push_utfstr(&line[cursor..]);
+    PasteResult::Buffer(out, cursor + insert.len())
+}
+
+/// get_quote for zsh: the quote still open at offset `len` of the token.
+fn zsh_get_quote(tok: &wstr, len: usize) -> Option<char> {
+    zsh_quote_state(tok, len)
+}
+
+/// unescaped_quote for zsh: is s[pos] a quote character that acts as a quote?
+fn zsh_unescaped_quote(s: &wstr, pos: usize) -> Option<char> {
+    let c = *s.as_char_slice().get(pos)?;
+    if !matches!(c, '\'' | '"') {
+        return None;
+    }
+    match zsh_quote_state(s, pos) {
+        // Unquoted: a quote counts unless backslash-escaped.
+        None => (!is_backslashed(s, pos)).then_some(c),
+        // Inside a quote: only the matching closing quote counts.
+        Some('\'') => (c == '\'').then_some(c),
+        Some(_) => (c == '"' && !is_backslashed(s, pos)).then_some(c),
+    }
+}
+
+fn parse_flags(code: &wstr) -> Option<CompleteFlags> {
+    let c: Vec<char> = code.chars().collect();
+    if c.len() != 6 {
+        return None;
+    }
+    let mut f = CompleteFlags::default();
+    f.replaces = match c[0] {
+        'n' => None,
+        'T' => Some(ReplacementScope::Token(WillReplaceToken { show_pager_prefix: true })),
+        't' => Some(ReplacementScope::Token(WillReplaceToken { show_pager_prefix: false })),
+        'L' => Some(ReplacementScope::Line),
+        _ => return None,
+    };
+    f.wants_suffix = match c[1] {
+        'n' => WantsSuffix::No,
+        's' => WantsSuffix::Yes(crate::complete::SuffixType { for_variable_name: false }),
+        'v' => WantsSuffix::Yes(crate::complete::SuffixType { for_variable_name: true }),
+        _ => return None,
+    };
+    f.wants_escaping = match c[2] {
+        'n' => WantsEscaping::No,
+        't' => WantsEscaping::Yes { escape_tildes: true },
+        'k' => WantsEscaping::Yes { escape_tildes: false },
+        _ => return None,
+    };
+    f.keep_variable_override_prefix = c[3] == '1';
+    f.duplicates_argument = c[4] == '1';
+    f.dont_sort = c[5] == '1';
+    Some(f)
+}
+
+/// Reader's completion_apply_to_command_line, zsh quoting layer.
+fn zsh_apply(
+    ctx: &mut OperationContext,
+    val_str: &wstr,
+    flags: CompleteFlags,
+    command_line: &wstr,
+    inout_cursor_pos: &mut usize,
+    append_only: bool,
+    is_unique: bool,
+    z: ZshOpts,
+) -> WString {
+    let cursor_pos = *inout_cursor_pos;
+    let mut back_into_trailing_quote = false;
+
+    let mut suffix_builder = flags.suffix_type().map(|suffix_type| (suffix_type, ' '));
+    let have_suffix = command_line.char_at(cursor_pos) == ' ';
+    let escape_flags = match flags.wants_escaping {
+        WantsEscaping::Yes { escape_tildes } => {
+            let mut escape_flags = EscapeFlags::default();
+            if append_only || !is_unique || suffix_builder.is_none() {
+                escape_flags.no_quoted = true;
+            }
+            if !escape_tildes {
+                escape_flags.no_tilde = true;
+            }
+            Some(escape_flags)
+        }
+        WantsEscaping::No => None,
+    };
+    let keep_variable_override = flags.keep_variable_override_prefix;
+
+    if flags.replaces_line() {
+        let cmdsub = get_cmdsubst_extent(command_line, cursor_pos);
+        return if !command_line[cmdsub.clone()].contains('\n') {
+            *inout_cursor_pos = cmdsub.start + val_str.len();
+            command_line[..cmdsub.start].to_owned() + val_str + &command_line[cmdsub.end..]
+        } else {
+            replace_line_at_cursor(command_line, inout_cursor_pos, val_str)
+        };
+    }
+
+    let mut maybe_add_slash = |suffix: &mut char, token: &wstr| {
+        let mut expanded = token.to_owned();
+        if expand_one(&mut expanded, ExpandFlags::FAIL_ON_CMDSUBST, ctx, None)
+            && wstat(&expanded).is_ok_and(|md| md.is_dir())
+        {
+            *suffix = '/';
+        }
+    };
+
+    if flags.replaces_token() {
+        if let Some((suffix_type, suffix)) = suffix_builder.as_mut() {
+            if suffix_type.for_variable_name {
+                maybe_add_slash(suffix, val_str);
+            }
+        }
+        let mut move_cursor = 0;
+        let (range, _) = get_token_extent(command_line, cursor_pos);
+        let mut sb = command_line[..range.start].to_owned();
+        if keep_variable_override {
+            let tok = &command_line[range.clone()];
+            if let Some(separator_pos) = variable_assignment_equals_pos(tok) {
+                let key = &tok[..=separator_pos];
+                sb.push_utfstr(key);
+                move_cursor += key.len();
+            }
+        }
+        if let Some(escape_flags) = escape_flags {
+            let escaped = zsh_escape_script(val_str, escape_flags, z);
+            sb.push_utfstr(&escaped);
+            move_cursor += escaped.len();
+        } else {
+            sb.push_utfstr(val_str);
+            move_cursor += val_str.len();
+        }
+        if let Some((_st, suffix)) = suffix_builder {
+            if !have_suffix {
+                sb.push(suffix);
+            }
+            move_cursor += 1;
+        }
+        sb.push_utfstr(&command_line[range.end..]);
+        *inout_cursor_pos = range.start + move_cursor;
+        return sb;
+    }
+
+    let mut quote = None;
+    let replaced = if let Some(mut escape_flags) = escape_flags {
+        let (tok, _) = get_token_extent(command_line, cursor_pos);
+        let mut have_token = false;
+        if tok.contains(&cursor_pos) || cursor_pos == tok.end {
+            quote = zsh_get_quote(&command_line[tok.clone()], cursor_pos - tok.start);
+            have_token = !tok.is_empty();
+        }
+        if quote.is_none() && !append_only && cursor_pos > 0 {
+            let trailing_quote = zsh_unescaped_quote(command_line, cursor_pos - 1);
+            if trailing_quote.is_some() {
+                quote = trailing_quote;
+                back_into_trailing_quote = true;
+            }
+        }
+        if have_token {
+            escape_flags.no_quoted = true;
+        }
+        zsh_escape_with_quote(val_str, quote, escape_flags, z)
+    } else {
+        val_str.to_owned()
+    };
+
+    let mut insertion_point = cursor_pos;
+    if back_into_trailing_quote {
+        insertion_point -= 1;
+    }
+    let mut result = command_line.to_owned();
+    result.insert_utfstr(insertion_point, &replaced);
+    let mut new_cursor_pos =
+        insertion_point + replaced.len() + if back_into_trailing_quote { 1 } else { 0 };
+    if let Some((suffix_type, mut suffix)) = suffix_builder {
+        if suffix_type.for_variable_name {
+            let (tok, _) = get_token_extent(command_line, cursor_pos);
+            maybe_add_slash(&mut suffix, &result[tok.start..new_cursor_pos]);
+        }
+        if suffix != '/' {
+            if let Some(quote) = quote {
+                if zsh_unescaped_quote(command_line, insertion_point) != Some(quote) {
+                    result.insert(new_cursor_pos, quote);
+                    new_cursor_pos += 1;
+                }
+            }
+        }
+        if !have_suffix {
+            result.insert(new_cursor_pos, suffix);
+        }
+        new_cursor_pos += 1;
+    }
+    *inout_cursor_pos = new_cursor_pos;
+    result
+}
