diff --git a/Doc/Zsh/options.yo b/Doc/Zsh/options.yo
index 6f3bef189..fb6fdac91 100644
--- a/Doc/Zsh/options.yo
+++ b/Doc/Zsh/options.yo
@@ -1565,6 +1565,16 @@ tt(POSIX_JOBS) in order for the builtin command tt(wait) to return the
 status of background jobs that had already exited.  This is no longer
 the case.
 )
+pindex(SIGINT_NEWLINE)
+pindex(NO_SIGINT_NEWLINE)
+pindex(SIGINTNEWLINE)
+pindex(NOSIGINTNEWLINE)
+item(tt(SIGINT_NEWLINE) <D>)(
+When a foreground job is interrupted by tt(SIGINT) and no job status is
+reported for it, print a newline so that the next output starts on a fresh
+line.  Unset it when the prompt itself takes care of output left without a
+final newline (as tt(PROMPT_SP) does).
+)
 enditem()
 
 subsect(Prompting)
